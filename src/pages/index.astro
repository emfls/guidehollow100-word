---
import Layout from '../layouts/Layout.astro';
import Ad from '../components/AdPlacement.astro';
import site from '../site.json';
import {getCollection} from 'astro:content';
const posts=(await getCollection('guides',({data})=>site.launchReady&&!data.draft&&data.reviewed&&data.language==='ko'&&data.sources.length>0)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Layout title={site.pageTitle} description={site.description}>
<section class="hero"><div class="wrap"><p class="eyebrow">GuideHollow / {site.section}</p><h1>{site.hero}</h1><p class="lead">{site.description}</p><a class="button" href="/guides/">가이드 살펴보기</a></div></section>
<section class="wrap section"><h2>{site.short} 주요 주제</h2><p class="muted">필요한 문제부터 찾아보고, 원인과 해결 방법을 순서대로 확인하세요.</p>
<div class="grid">{site.topics.map((topic,i)=><article class="topic"><span>주제 {String(i+1).padStart(2,'0')}</span><h3>{topic}</h3><p>확인 사항부터 해결 절차, 결과 점검까지 차근차근 안내합니다.</p></article>)}</div>
<Ad placement="home-after-topics"/>
</section>
<section class="wrap section"><h2>최신 가이드</h2>{posts.length?<ul class="list">{posts.slice(0,5).map(p=><li><a href={'/guides/'+p.id+'/'}>{p.data.title}</a><p>{p.data.description}</p></li>)}</ul>:<div class="note"><strong>가이드를 준비하고 있습니다.</strong><p>검수가 완료되지 않은 원고는 공개하지 않습니다.</p></div>}</section>
</Layout>