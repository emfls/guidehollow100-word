---
import Layout from '../layouts/Layout.astro';
import Ad from '../components/AdPlacement.astro';
import site from '../site.json';
import guide from '../launch-content.json';
import {getCollection} from 'astro:content';
const posts=(await getCollection('guides',({data})=>site.launchReady&&!data.draft&&data.reviewed&&data.language==='ko'&&data.sources.length>0)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Layout title={site.pageTitle} description={site.description}>
<section class="hero"><div class="wrap"><p class="eyebrow">GuideHollow / {site.section}</p><h1>{site.hero}</h1><p class="lead">{site.description}</p><p class="hero-intro">{guide.intro}</p><a class="button" href="#quick-checks">증상별 해결 순서 살펴보기</a></div></section>
<section class="wrap section" aria-labelledby="topic-heading"><h2 id="topic-heading">{site.short} 문제부터 찾아보기</h2>
<p class="muted">현재 증상과 가까운 항목을 선택하면 먼저 확인할 단계로 이동합니다.</p>
<div class="grid">{guide.checks.map((topic,i)=><a class="topic topic-link" href={'#'+topic.id}><span>점검 {String(i+1).padStart(2,'0')}</span><h3>{topic.title}</h3><p>{topic.when}</p><span class="topic-more">점검 방법 보기 →</span></a>)}</div>
<Ad placement="home-after-topics"/>
</section>
<section class="wrap section" id="quick-checks"><p class="eyebrow">문제 해결 시작점</p><h2>먼저 확인할 순서</h2><p class="muted">아래 내용은 일반적인 1차 점검이며, 실제 기기와 소프트웨어 버전에 따라 달라질 수 있습니다.</p>
<div class="diagnostics">{guide.checks.map((entry,i)=><section class="diagnostic" id={entry.id} aria-labelledby={entry.id+'-title'}><p class="diagnostic-index">점검 {String(i+1).padStart(2,'0')} · {site.short}</p><h3 id={entry.id+'-title'}>{entry.title}</h3><p class="diagnostic-when">{entry.when}</p><ol>{entry.steps.map(step=><li>{step}</li>)}</ol><p class="diagnostic-caution"><strong>주의:</strong> {entry.tip}</p></section>)}</div>
</section>
<section class="wrap section help-reference"><h2>공식 자료에서 더 확인하기</h2><p>메뉴가 다르거나 문제가 지속된다면 제조사와 서비스 제공자의 최신 안내를 확인하세요. 아래 링크는 외부 공식 도움말로 연결됩니다.</p><ul>{guide.references.map(item=><li><a href={item.url} target="_blank" rel="noopener noreferrer">{item.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul>
<p class="meta">페이지 안내 점검일: {new Intl.DateTimeFormat('ko-KR',{dateStyle:'long',timeZone:'Asia/Seoul'}).format(new Date(guide.updated+'T00:00:00+09:00'))} · <a href="/editorial/">편집 원칙</a></p></section>
<section class="wrap section questions"><h2>자주 묻는 질문</h2><div class="faq-items">{guide.faq.map(item=><section class="faq-item"><h3>{item.question}</h3><p>{item.answer}</p></section>)}</div></section>
<section class="wrap section"><h2>자세한 한국어 가이드</h2>{posts.length?<ul class="list">{posts.slice(0,6).map(p=><li><a href={'/guides/'+p.id+'/'}>{p.data.title}</a><p>{p.data.description}</p></li>)}</ul>:<p class="muted">상세 원고는 공식 자료 확인과 검수 후 순차적으로 추가됩니다. 위의 1차 점검은 지금 바로 확인할 수 있습니다.</p>}</section>
</Layout>