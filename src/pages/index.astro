---
import Layout from '../layouts/Layout.astro';
import Ad from '../components/AdPlacement.astro';
import site from '../site.json';
import {getCollection} from 'astro:content';
const posts=(await getCollection('guides',({data})=>site.launchReady&&!data.draft&&data.reviewed&&data.sources.length>0)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Layout title={site.title+' | Clear practical guides'} description={site.description}>
<section class="hero"><div class="wrap"><p class="eyebrow">GuideHollow 100 / {site.short}</p><h1>{site.hero}</h1><p class="lead">{site.description}</p><a class="button" href="/guides/">Browse guides</a></div></section>
<section class="wrap section"><h2>Explore {site.short} topics</h2><p class="muted">Focused topics, researched and reviewed before release.</p><div class="grid">{site.topics.map((t,i)=><article class="topic"><span>TOPIC {String(i+1).padStart(2,'0')}</span><h3>{t}</h3><p>Clear checks, safe steps and practical verification.</p></article>)}</div><Ad network="adsense" placement="home-after-topics"/></section>
<section class="wrap section"><h2>Reviewed guides</h2>{posts.length?<ul class="list">{posts.slice(0,5).map(p=><li><a href={'/guides/'+p.id+'/'}>{p.data.title}</a><p>{p.data.description}</p></li>)}</ul>:<div class="note"><strong>Guides are in editorial preparation.</strong><p>Unreviewed articles are not published.</p></div>}<Ad network="coupang" placement="home-after-guides"/></section>
</Layout>
