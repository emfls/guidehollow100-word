---
import Layout from '../../layouts/Layout.astro';
import site from '../../site.json';
import {getCollection} from 'astro:content';
const posts=(await getCollection('guides',({data})=>site.launchReady&&!data.draft&&data.reviewed)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Layout title={'Guides | '+site.title} description={'Reviewed guides for '+site.short}>
<div class="wrap content"><p class="eyebrow">GUIDE LIBRARY</p><h1>Guides</h1><p>Only reviewed articles are listed here.</p>
{posts.length?<ul class="list">{posts.map(p=><li><a href={'/guides/'+p.id+'/'}>{p.data.title}</a><p>{p.data.description}</p></li>)}</ul>:<div class="note">No reviewed articles published yet. Guides are being prepared.</div>}
</div></Layout>
