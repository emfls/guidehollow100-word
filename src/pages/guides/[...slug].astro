---
import Layout from '../../layouts/Layout.astro';
import site from '../../site.json';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){
 const s=(await import('../../site.json')).default;
 const posts=await getCollection('guides',({data})=>s.launchReady&&!data.draft&&data.reviewed);
 return posts.map(p=>({params:{slug:p.id},props:{post:p}}));
}
const {post}=Astro.props;
const {Content}=await render(post);
---
<Layout title={post.data.title+' | '+site.title} description={post.data.description}>
<article class="wrap content"><p class="eyebrow">{site.short} / {post.data.category}</p><h1>{post.data.title}</h1><p class="meta">Published {post.data.pubDate.toLocaleDateString('en-US')}</p><p class="lead">{post.data.description}</p><Content/><hr/><p class="meta">Check software and device compatibility before making changes. <a href="/editorial/">Editorial policy</a>.</p><a href="/guides/">All guides</a></article>
</Layout>
