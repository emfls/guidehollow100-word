---
import Layout from '../layouts/Layout.astro';
import site from '../site.json';
---
<Layout title={'Privacy | '+site.title} description={'Privacy information for '+site.title}>
<div class="wrap content"><p class="eyebrow">PRIVACY</p><h1>Privacy notice</h1><p>Reviewed: 30 October 2026. The initial static site code contains no accounts, forms, analytics tags or advertising scripts.</p><h2>Hosting and external links</h2><p>Hosting infrastructure may process technical request information for delivery and security. Official resources linked from articles have their own privacy practices.</p><h2>Updates</h2><p>This notice must be revised if advertising, analytics, external embeds or forms are introduced.</p></div></Layout>
