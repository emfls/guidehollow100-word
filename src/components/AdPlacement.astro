---
import site from '../site.json';
import ads from '../config/monetization.json';
const {placement}=Astro.props;
const banner=ads.coupang.dynamicBanners[placement];
const id=Number(banner?.id);
const trackingCode=String(banner?.trackingCode||'');
const valid=Number.isSafeInteger(id)&&id>0&&/^AF[A-Za-z0-9_-]{3,30}$/.test(trackingCode);
const show=site.launchReady&&ads.coupang.enabled&&banner?.enabled===true&&banner?.mode==='script'&&valid;
const options={id,template:banner?.template||'carousel',trackingCode,width:String(banner?.width||'680'),height:String(banner?.height||'140'),tsource:String(banner?.tsource||'')};
const widgetCode='new PartnersCoupang.G('+JSON.stringify(options).replace(/</g,'\\u003c')+');';
---
{show?<aside class="ad-placement dynamic-banner" aria-label="Coupang Partners advertisement">
<p class="ad-label">Advertisement · Coupang Partners</p>
<div class="dynamic-banner-frame"><script is:inline set:html={widgetCode}/></div>
<p class="ad-small">This website participates in Coupang Partners and receives a commission from qualifying purchases. 이 사이트는 쿠팡 파트너스 활동의 일환으로 이에 따른 일정액의 수수료를 제공받습니다. <a href="/disclosure/">Advertising disclosure</a>.</p>
</aside>:<template data-reserved-network="coupang" data-reserved-placement={placement}></template>}
