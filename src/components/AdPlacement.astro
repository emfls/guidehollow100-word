---
import site from '../site.json';
import ads from '../config/monetization.json';
const {network,placement}=Astro.props;
const unit=network==='adsense'?ads.adsense.slots[placement]:undefined;
const banner=network==='coupang'?ads.coupang.banners[placement]:undefined;
const adsense=site.launchReady&&ads.adsense.enabled&&/^ca-pub-\d{16}$/.test(ads.adsense.client)&&/^\d{8,20}$/.test(String(unit||''));
const coupang=site.launchReady&&ads.coupang.enabled&&banner?.approved===true&&/^https:\/\//.test(banner?.url||'')&&/^https:\/\//.test(banner?.imageUrl||'')&&Boolean(banner?.alt);
---
{adsense?<aside class="ad-placement" aria-label="Advertisement"><span class="ad-label">Advertisement</span><ins class="adsbygoogle" style="display:block" data-ad-client={ads.adsense.client} data-ad-slot={unit} data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(window.adsbygoogle=window.adsbygoogle||[]).push({});</script></aside>:coupang?<aside class="ad-placement" aria-label="Sponsored link"><span class="ad-label">Sponsored links</span><a href={banner.url} target="_blank" rel="sponsored noopener noreferrer"><img src={banner.imageUrl} alt={banner.alt} width="660" height="180" loading="lazy" decoding="async"/></a><p class="ad-small">Affiliate advertising: qualifying purchases may earn us a commission, at no extra cost to you. <a href="/disclosure/">Disclosure</a>.</p></aside>:<template data-reserved-network={network} data-reserved-placement={placement}></template>}