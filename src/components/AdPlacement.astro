---
import site from '../site.json';
import ads from '../config/monetization.json';
const {network,placement}=Astro.props;
const unit=network==='adsense'?ads.adsense.slots[placement]:undefined;
const banner=network==='coupang'?ads.coupang.dynamicBanners[placement]:undefined;
const id=Number(banner?.id);
const trackingCode=String(banner?.trackingCode||'');
const scriptValid=Number.isSafeInteger(id)&&id>0&&/^AF[A-Za-z0-9_-]{3,30}$/.test(trackingCode);
const iframeValid=typeof banner?.iframeSrc==='string'&&/^https:\/\/[^\s"'<>]+$/.test(banner.iframeSrc);
const scriptMode=banner?.mode==='script'&&scriptValid;
const iframeMode=banner?.mode==='iframe'&&iframeValid;
const adsense=site.launchReady&&ads.adsense.enabled&&/^ca-pub-\d{16}$/.test(ads.adsense.client)&&/^\d{8,20}$/.test(String(unit||''));
const coupang=site.launchReady&&ads.coupang.enabled&&banner?.enabled===true&&(scriptMode||iframeMode);
const widgetOptions=scriptMode?{id,template:banner.template||'carousel',trackingCode,width:banner.width||'100%',height:Number(banner.height)||180}:null;
const widgetScript=widgetOptions?'new PartnersCoupang.G('+JSON.stringify(widgetOptions).replace(/</g,'\\u003c')+');':'';
---
{adsense?<aside class="ad-placement" aria-label="Advertisements"><span class="ad-label">Advertisements</span><ins class="adsbygoogle" style="display:block" data-ad-client={ads.adsense.client} data-ad-slot={unit} data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(window.adsbygoogle=window.adsbygoogle||[]).push({});</script></aside>:coupang?<aside class="ad-placement dynamic-banner" aria-label="Coupang Partners advertisement">
<p class="ad-label">Advertisement · Coupang Partners</p>
<div class="dynamic-banner-frame">{scriptMode?<script is:inline set:html={widgetScript}/>:<iframe src={banner.iframeSrc} title="Coupang Partners dynamic advertisement" width="100%" height={Number(banner.height)||180} loading="lazy" scrolling="no" referrerpolicy="strict-origin-when-cross-origin"></iframe>}</div>
<p class="ad-small">This website participates in Coupang Partners and receives a commission from qualifying purchases. 이 사이트는 쿠팡 파트너스 활동의 일환으로 이에 따른 일정액의 수수료를 제공받습니다. <a href="/disclosure/">Advertising disclosure</a>.</p>
</aside>:<template data-reserved-network={network} data-reserved-placement={placement}></template>}